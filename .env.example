# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://onboarding:onboarding@localhost:5432/onboarding_hub

# ─── App access ──────────────────────────────────────────────
# Shared password for the web UI. Leave empty ONLY for local development.
APP_PASSWORD=
# Random 32+ char string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used by the cron worker and links in Jira comments)
APP_URL=http://localhost:3000

# ─── Daily sync (cron) ───────────────────────────────────────
# Secret the cron caller must send as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# Used by the self-hosted worker (scripts/cron-worker.ts). Vercel uses vercel.json (UTC).
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=Asia/Yerevan
# Which sources the daily sync runs, in order
SYNC_SOURCES=leapsome,timebase,jira

# ─── Leapsome ────────────────────────────────────────────────
# Settings → Integrations and imports → API. Token is sent as Bearer.
LEAPSOME_API_TOKEN=
LEAPSOME_BASE_URL=https://api.leapsome.com/v1
LEAPSOME_USERS_PATH=/users
LEAPSOME_PAGE_SIZE=100

# ─── Jira Cloud ──────────────────────────────────────────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Which tickets are onboarding requests
JIRA_ONBOARDING_JQL=project = HR AND issuetype = "Onboarding" AND updated >= -7d ORDER BY created DESC
# Map app fields → Jira custom field ids (find ids in Jira → Settings → Issues → Custom fields)
# e.g. {"fullName":"customfield_10101","startDate":"customfield_10102","businessUnit":"customfield_10103"}
JIRA_FIELD_MAP={}
# Fields an onboarding ticket must contain
JIRA_REQUIRED_FIELDS=fullName,email,startDate,businessUnit,jobTitle,location,manager
# Post a comment on the Jira ticket listing missing information (true/false)
JIRA_COMMENT_ON_MISSING=false

# ─── Timebase ────────────────────────────────────────────────
# Timebase has no public API docs; configure the endpoint your account exposes.
TIMEBASE_BASE_URL=
TIMEBASE_API_KEY=
# Header used for the key: "Authorization: Bearer <key>" (bearer) or "X-API-Key: <key>" (x-api-key)
TIMEBASE_AUTH_STYLE=bearer
TIMEBASE_EMPLOYEES_PATH=/employees
# Map app fields → Timebase response keys (dot paths allowed)
# e.g. {"timebaseId":"id","email":"email","location":"office.name","rotation":"rotation","rotationDate":"rotationDate"}
TIMEBASE_FIELD_MAP={}

# ─── Claude (Anthropic API) ──────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
