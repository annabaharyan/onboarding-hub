# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://onboarding:onboarding@localhost:5432/onboarding_hub

# ─── App access ──────────────────────────────────────────────
# Shared password for the web UI. Leave empty ONLY for local development.
APP_PASSWORD=
# Random 32+ char string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used by the cron worker and links in Jira comments)
APP_URL=http://localhost:3000

# ─── Daily sync (cron) ───────────────────────────────────────
# Secret the cron caller must send as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# Used by the self-hosted worker (scripts/cron-worker.ts). Vercel uses vercel.json (UTC).
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=Asia/Yerevan
# Which sources the daily sync runs, in order
SYNC_SOURCES=leapsome,timebase,jira

# ─── Leapsome ────────────────────────────────────────────────
# Settings → Integrations and imports → API. Token is sent as Bearer.
LEAPSOME_API_TOKEN=
LEAPSOME_BASE_URL=https://api.leapsome.com/v1
LEAPSOME_USERS_PATH=/users
LEAPSOME_PAGE_SIZE=100

# ─── Jira Cloud ──────────────────────────────────────────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Which tickets are onboarding requests
JIRA_ONBOARDING_JQL=project = HR AND issuetype = "Onboarding" AND updated >= -7d ORDER BY created DESC
# Map app fields → Jira custom field ids (find ids in Jira → Settings → Issues → Custom fields)
# e.g. {"fullName":"customfield_10101","startDate":"customfield_10102","businessUnit":"customfield_10103"}
JIRA_FIELD_MAP={}
# Fields an onboarding ticket must contain
JIRA_REQUIRED_FIELDS=fullName,email,startDate,businessUnit,jobTitle,location,manager
# Post a comment on the Jira ticket listing missing information (true/false).
# Comments are only posted once a request is collecting information. Always on in demo mode.
JIRA_COMMENT_ON_MISSING=true
# "mock" = demo mode: dummy tickets stored in the app, no Jira needed. "live" = real Jira API.
# When empty: live if JIRA_API_TOKEN is set (and doesn't start with "dummy"), otherwise mock.
JIRA_MODE=mock
# Status names in your Jira workflow. The Hub moves tickets to In progress when the employee is
# contacted and to Done when the first-day checklist is complete. Leave CANCELLED empty to keep
# the ticket's status when a request is cancelled.
JIRA_STATUS_OPEN=Open
JIRA_STATUS_IN_PROGRESS=Work in progress
JIRA_STATUS_DONE=Done
JIRA_STATUS_CANCELLED=

# ─── Onboarding flow ─────────────────────────────────────────
# Collection is suggested this many days before the start date (the team can change it per person)
ONBOARDING_COLLECTION_LEAD_DAYS=21
# Timezone used for "today" (collection dates, first days)
APP_TIMEZONE=Asia/Yerevan

# ─── Timebase ────────────────────────────────────────────────
# Timebase has no public API docs; configure the endpoint your account exposes.
TIMEBASE_BASE_URL=
TIMEBASE_API_KEY=
# Header used for the key: "Authorization: Bearer <key>" (bearer) or "X-API-Key: <key>" (x-api-key)
TIMEBASE_AUTH_STYLE=bearer
TIMEBASE_EMPLOYEES_PATH=/employees
# Map app fields → Timebase response keys (dot paths allowed)
# e.g. {"timebaseId":"id","email":"email","location":"office.name","rotation":"rotation","rotationDate":"rotationDate"}
TIMEBASE_FIELD_MAP={}

# ─── Claude (Anthropic API) ──────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Climate survey (Google Sheet, via a service account) ────
# Google Cloud → IAM & Admin → Service Accounts → create one → Keys → Add key (JSON).
# Share the response Sheet (File → Share) with this service account's email, as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" field from the downloaded JSON key, including the BEGIN/END lines.
# If pasted as a single line, literal \n sequences are handled automatically.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# From the Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
CLIMATE_SURVEY_SHEET_ID=
# Which cells to read; default covers the whole sheet
CLIMATE_SURVEY_SHEET_RANGE=A:ZZ
